{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobolens",
  "version": "0.1.0",
  "identifier": "dev.cobolens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tauri:before-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cobolens",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:11434 http://localhost:11434 http://[::1]:11434 https://api.anthropic.com https://api.openai.com https://openrouter.ai",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:11434 http://localhost:11434 http://[::1]:11434 http://127.0.0.1:1420 http://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1420 https://api.anthropic.com https://api.openai.com https://openrouter.ai",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/": "binaries/",
      "../samples/mini-bank/": "samples/mini-bank/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
